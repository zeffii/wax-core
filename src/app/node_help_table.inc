  {"duette", "lfowave", "LFO shape."},
  {"duette", "lfomode", "fast: 0.5 Hz to 2.8 kHz, up into the audio range. slow: 0.05 to 28 Hz. 1-shot: one half cycle per note, then it stops."},
  {"duette", "lforate", "LFO speed within the mode."},
  {"duette", "lfoint", "How far the LFO moves its target."},
  {"duette", "lfotarget", "What the LFO moves: pitch, the shapes, or the cutoff."},
  {"duette", "drive", "Saturates the sound after the filter."},
