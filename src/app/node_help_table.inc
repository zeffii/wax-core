  {"modchan", "fx", "The effect word of the row, as in a MOD cell: effect nibble then parameter (0C40 is C40, set volume 40). Written by Cmd 01."},
  {"modchan", "level", "Level of the channel."},
  {"modchan", "pan", "Stereo position: -1 left, 1 right. The Amiga is hard panned, left right right left."},
  {"modchan", "interp", "1: smooth interpolation between samples. 0: nearest sample, the rough sound of the real hardware."},
  {"tempo", "bpm", "Beats per minute. A pattern can change it as the song plays."},
  {"tempo", "swing", "Percent: 50 is straight, 75 the most."},
  {"tempo", "tpb", "Ticks per beat."},
  {"tempo", "volume", "The volume of the whole mix."},
  {"tempo", "limit", "The master limiter, after the volume. It holds the peaks of the whole mix under the ceiling so nothing clips. 1 on, 0 off; it starts off, because it changes the sound of the mix."},
