  {"duette", "portmode", "auto: glide only when notes overlap. always: glide from every note."},
  {"duette", "slide", "Glide time of a note with the Sld flag, in ms. It keeps the envelope running instead of restarting it."},
  {"duette", "keytrack", "How much the cutoff follows the note, so high notes are brighter."},
  {"duette", "cutvel", "How much velocity opens the filter."},
  {"duette", "ampvel", "How much velocity changes the level."},
  {"duette", "tune", "Tunes the voice in semitones."},
  {"duette", "level", "Overall level."},
  {"duette", "sld", "Written in the Sld column on a note's row: 1 glides into this note without restarting the envelope. Blank is no slide; it counts for that note only."},
