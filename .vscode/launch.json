{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "wax-app: concrete demo",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/${command:cmake.buildType}/wax-app.exe",
      "args": ["${workspaceFolder}/tests/songs/concrete.wax"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "wax-play: concrete demo",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/${command:cmake.buildType}/wax-play.exe",
      "args": ["${workspaceFolder}/tests/songs/concrete.wax"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "wax-tests",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${command:cmake.buildDirectory}/${command:cmake.buildType}/wax-tests.exe",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
