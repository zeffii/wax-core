{"format": "webtracker", "version": 1, "song": {"name": "cloves", "bpm": 136, "ticksPerBeat": 8, "length": 1552, "swing": 0.53}, "instruments": {"master": {"graph": {"nodes": [{"id": "m", "type": "tempo", "x": 40, "y": 40, "params": {"bpm": 136, "swing": 53, "tpb": 8, "volume": 1}, "hidden": true}, {"id": "out", "type": "out", "x": 240, "y": 40, "params": {"gain": 1}}, {"id": "bus", "type": "bus-in", "x": 40, "y": 140}], "connections": []}, "noteColumns": 0, "exposed": [{"node": "m", "param": "bpm", "label": "BPM", "bits": 16}, {"node": "m", "param": "swing", "label": "Swg"}, {"node": "m", "param": "tpb", "label": "TPB"}, {"node": "m", "param": "volume", "label": "Vol"}, {"node": "m", "param": "limit", "label": "Lim", "long": "Limiter", "bits": 4}, {"node": "m", "param": "ceiling", "label": "Ceil", "long": "Ceiling"}, {"node": "m", "param": "boost", "label": "Gain", "long": "Limiter gain"}, {"node": "m", "param": "release", "label": "Rel", "long": "Limiter release", "scale": "log"}, {"node": "m", "param": "carve", "label": "Crv", "long": "Carve", "bits": 4}, {"node": "m", "param": "cvamt", "label": "CAmt", "long": "Carve amount"}, {"node": "m", "param": "cvdepth", "label": "CDep", "long": "Carve depth"}, {"node": "m", "param": "cvfocus", "label": "CFoc", "long": "Carve focus"}], "commands": []}, "lone": {"graph": {"nodes": [{"id": "synth", "type": "lone", "x": 24, "y": 107, "params": {"pdec": 1.9542177866864014, "psus": 0.19931448157669238, "prel": 143.63393431515834, "sub": 0.08963153384747215, "cutoff": 6924.0726371074015, "res": 0.6295051353874883, "fdec": 441.17647058823496, "fsus": 0.7586975149957155, "frel": 110.29411764705875, "pamt": 0.04575835475578405, "fenv": 4.402399314481576, "drive": 0.14995715509854327, "fatk": 0.44988807909782386, "patk": 110.29411764705878, "position": 0.19931448157669238, "wt": 0.7861182519280205, "saw": 0.33641816623821763, "pulse": 0.6874035989717223, "pw": 0.2506514933581521, "pwlfo": 0.036970132836957444, "pwenv": -0.07812339331619539, "subwave": 1, "suboct": 1, "noise": 0, "sync": 1, "atk": 21.288465107252975, "dec": 75.20449078027373, "sus": 0.24189863778661477, "rel": 13.786764705882348, "lfoRate": 0.07083333333333333, "lfoShape": 0, "lfoDelay": 386.0294117647059, "vib": 26.178187663930956, "glide": 55.14705882352941, "plfo": 0.20479862896315337, "syncratio": 1, "fold": 0.1170522707797772, "keytrack": 0.7641816623821766, "fmod": 0}}, {"id": "poly", "type": "voices", "x": 170, "y": 108}, {"id": "out", "type": "out", "params": {"gain": 0.5}, "x": 594, "y": 132}, {"id": "prismacanyon1", "type": "genexpr", "x": 380, "y": 130, "params": {"p1": 0.4, "p2": 0.6, "p3": 0.2}, "data": {"code": "// stress: many operators, Data, Delay, tuples, if/else, compound ops\nParam a(0.3, min=0, max=2);\nParam b(2, min=-4, max=8);\nParam c(100, min=1, max=500);\nHistory h1(0.25);\nHistory h2(0);\nHistory count(0);\nData tab(64);\nDelay dl(4096);\nDelay dl2(samplerate / 4);\n\nx = in1 + in2 * 0.5;\nn = noise();\ntab.write(x, count);\ncount = (count + 1) % 64;\ny = peek(tab, count + 3) * a + dl.read(c * 3.7) * 0.4;\ndl.write(x + y * 0.3);\ndl2.write(x * 0.5 + dl2.read(900.5) * 0.6);\np, q = x * 2, y - x;\np, q = q, p;\nif (abs(p) > 0.2) { h1 += 0.001; } else { h1 *= 0.9999; h1 /= 1.00001; }\nif (q < 0) h2 = h2 + (q - h2) / 3;\nh1 = clamp(h1, -1, 1);\nr = scale(p, -1, 1, b, 3) + fold(q * 3, -0.5, 0.5) + wrap(q * 5, 0, 1) + mod(p, 0.3);\ns = sin(r) * cos(q) + tanh(p * 2) + sinh(clip(q, -1, 1)) + atan2(p, q + 2) + atan(q) + asin(p) + acos(q);\nt = sqrt(abs(s)) + log(abs(s) + 1) + log2(abs(p) + 1) + log10(abs(q) + 1) + exp(clip(s, -3, 3)) + pow(abs(p), 1.7) + abs(p) ** 2;\nu = mtof(60 + b * 3) * 0.001 + ftom(abs(c) + 100) * 0.01 + dbtoa(-20 + b) + atodb(abs(a) + 0.1) * 0.01 + mstosamps(5) * 1e-4 + sampstoms(100);\nv = floor(r) + ceil(s) + round(t) + trunc(u) + fract(r) + sign(p) + min(p, q) + max(p, q);\nw = phasor(110 + c) + cycle(220) + delta(x) + change(q) + slide(x, 20, 200) + dcblock(y) + fixdenorm(h1 * 1e-20) + noise() * 0.1;\nz = (p > 0 && q > 0) + (p < 0 || q < 0) + !p + (p == q) + (p != q) + (p <= q) + (p >= q) + (p > q ? 1 : -1);\nm = -p ** 2 + 2 ** 3 ** 2 / 100 + 7 % 3 + 5 / 0;\nout1 = tanh(0.1 * (s + t * 0.1 + u * 0.01 + v * 0.01 + w * 0.1 + z * 0.1 + m * 0.01) + h1 * 0.2) * 0.5 + x * 0.3 + n * 0.01 * a;\nout2 = fixdenorm(h2) + dim(tab) * 0.0001 + y * 0.3;\n"}}], "connections": [["synth.out", "poly.in"], ["poly.out", "prismacanyon1.in1"], ["poly.out", "prismacanyon1.in2"], ["prismacanyon1.out1", "out.in"]], "voices": 6}, "noteColumns": 6, "exposed": [{"node": "synth", "param": "cutoff", "label": "Cut", "scale": "log"}, {"node": "synth", "param": "res", "label": "Res"}, {"node": "synth", "param": "position", "label": "Pos"}, {"node": "synth", "param": "fold", "label": "Fld"}], "commands": [{"id": 1, "node": "synth", "param": "cutoff", "scale": "log"}, {"id": 2, "node": "synth", "param": "res"}, {"id": 3, "node": "synth", "param": "fenv"}, {"id": 4, "node": "synth", "param": "position"}, {"id": 5, "node": "synth", "param": "pw"}, {"id": 6, "node": "synth", "param": "fold"}, {"id": 7, "node": "synth", "param": "glide"}, {"id": 8, "node": "synth", "param": "syncratio"}, {"id": 9, "node": "synth", "param": "sub"}, {"id": 10, "node": "synth", "param": "drive"}]}}, "samples": {}, "lanes": [{"id": "master", "instrument": "master", "patterns": {}, "placements": []}, {"id": "lone", "instrument": "lone", "patterns": {"1794611646149-1": {"name": "pat00", "index": 0, "color": 0, "rows": ["D-4 .. C-5 .. G-4 .. ... .. ... .. ... .. .. .. .. .. ......", "... .. ... .. ... .. ... .. ... .. ... .. .. .. .. .. ......", "=== .. === .. === .. ... .. ... .. ... .. .. .. .. .. ......", "... .. ... .. ... .. ... .. ... .. ... .. .. .. .. .. ......", "... .. ... .. ... .. ... .. ... .. ... .. .. .. .. .. ......", "... .. ... .. ... .. ... .. ... .. ... .. .. .. .. .. ......", "D-4 .. C-5 .. G-4 .. ... .. ... .. ... .. .. .. .. .. ......", "... .. ... .. ... .. ... .. ... .. ... .. .. .. 