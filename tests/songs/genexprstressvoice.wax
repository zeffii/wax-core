{"format": "webtracker", "version": 1, "song": {"name": "cloves", "bpm": 136, "ticksPerBeat": 8, "length": 1552, "swing": 0.53}, "instruments": {"master": {"graph": {"nodes": [{"id": "m", "type": "tempo", "x": 40, "y": 40, "params": {"bpm": 136, "swing": 53, "tpb": 8, "volume": 1}, "hidden": true}, {"id": "out", "type": "out", "x": 240, "y": 40, "params": {"gain": 1}}, {"id": "bus", "type": "bus-in", "x": 40, "y": 140}], "connections": []}, "noteColumns": 0, "exposed": [{"node": "m", "param": "bpm", "label": "BPM", "bits": 16}, {"node": "m", "param": "swing", "label": "Swg"}, {"node": "m", "param": "tpb", "label": "TPB"}, {"node": "m", "param": "volume", "label": "Vol"}, {"node": "m", "param": "limit", "label": "Lim", "long": "Limiter", "bits": 4}, {"node": "m", "param": "ceiling", "label": "Ceil", "long": "Ceiling"}, {"node": "m", "param": "boost", "label": "Gain", "long": "Limiter gain"}, {"node": "m", "param": "release", "label": "Rel", "long": "Limiter release", "scale": "log"}, {"node": "m", "param": "carve", "label": "Crv", "long": "Carve", "bits": 4}, {"node": "m", "param": "cvamt", "label": "CAmt", "long": "Carve amount"}, {"node": "m", "param": "cvdepth", "label": "CDep", "long": "Carve depth"}, {"node": "m", "param": "cvfocus", "label": "CFoc", "long": "Carve focus"}], "commands": []}, "lone": {"graph": {"nodes": [{"id": "synth", "type": "genexpr", "x": 24, "y": 107, "params": {"p1": 0.4, "p2": 0.6, "p3": 0.2}, "data": {"code": "// stress: many operators, Data, Delay, tuples, if/else, compound ops\nParam a(0.3, min=0, max=2);\nParam b(2, min=-4, max=8);\nParam c(100, min=1, max=500);\nHistory h1(0.25);\nHistory h2(0);\nHistory count(0);\nData tab(64);\nDelay dl(4096);\nDelay dl2(samplerate / 4);\n\nx = in1 + in2 * 0.5;\nn = noise();\ntab.write(x, count);\ncount = (count + 1) % 64;\ny = peek(tab, count + 3) * a + dl.read(c * 3.7) * 0.4;\ndl.write(x + y * 0.3);\ndl2.write(x * 0.5 + dl2.read(900.5) * 0.6);\np, q = x * 2, y - x;\np, q = q, p;\nif (abs(p) > 0.2) { h1 += 0.001; } else { h1 *= 0.9999; h1 /= 1.00001; }\nif (q < 0) h2 = h2 + (q - h2) / 3;\nh1 = clamp(h1, -1, 1);\nr = scale(p, -1, 1, b, 3) + fold(q * 3, -0.5, 0.5) + wrap(q * 5, 0, 1) + mod(p, 0.3);\ns = sin(r) * cos(q) + tanh(p * 2) + sinh(clip(q, -1, 1)) + atan2(p, q + 2) + atan(q) + asin(p) + acos(q);\nt = sqrt(abs(s)) + log(abs(s) + 1) + log2(abs(p) + 1) + log10(abs(q) + 1) + exp(clip(s, -3, 3)) + pow(abs(p), 1.7) + abs(p) ** 2;\nu = mtof(60 + b * 3) * 0.001 + ftom(abs(c) + 100) * 0.01 + dbtoa(-20 + b) + atodb(abs(a) + 0.1) * 0.01 + mstosamps(5) * 1e-4 + sampstoms(100);\nv = floor(r) + ceil(s) + round(t) + trunc(u) + fract(r) + sign(p) + min(p, q) + max(p, q);\nw = phasor(110 + c) + cycle(220) + delta(x) + change(q) + slide(x, 20, 200) + dcblock(y) + fixdenorm(h1 * 1e-20) + noise() * 0.1;\nz = (p > 0 && q > 0) + (p < 0 || q < 0) + !p + (p == q) + (p != q) + (p <= q) + (p >= q) + (p > q ? 1 : -1);\nm = -p ** 2 + 2 ** 3 ** 2 / 100 + 7 % 3 + 5 / 0;\nout1 = tanh(0.1 * (s + t * 0.1 + u * 0.01 + v * 0.01 + w * 0.1 + z * 0.1 + m * 0.01) + h1 * 0.2) * 0.5 + x * 0.3 + n * 0.01 * a;\nout2 = fixdenorm(h2) + dim(tab) * 0.0001 + y * 0.3;\n"}}, {"id": "poly", "type": "voices", "x": 170, "y": 108}, {"id": "out", "type": "out", "params": {"gain": 0.5}, "x": 594, "y": 132}, {"id": "prismacanyon1", "type": "prismacanyon", "x": 380, "y": 130, "params": {"time": 588.1233933161953, "cutoff": 13660.942587832049, "dry": 0.4625535561268209, "reverb": 0.48449014567266496, "echo": 0.15912596401028278, "intensity": 0.916649528706084, "bass": -6.689974293059126, "treble": -7.611311053984576}}], "connections": [["synth.out1", "poly.in"], ["poly.out", "out.in"]], "voices": 6}, "noteColumns": 6, "exposed": [{"node": "synth", "param": "p1", "label": "Cut"}, {"node": "synth", "param": "p1", "label": "Res"}, {"node": "synth", "param": "p1", "label": "Pos"}, {"node": "synth", "param": "p1", "label": "Fld"}], "commands": [{"id": 1, "node": "synth", "param": "p1"}, {"id": 2, "node": "synth", "