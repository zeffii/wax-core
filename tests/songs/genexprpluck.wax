{"format": "webtracker", "version": 1, "song": {"name": "cloves", "bpm": 136, "ticksPerBeat": 8, "length": 1552, "swing": 0.53}, "instruments": {"master": {"graph": {"nodes": [{"id": "m", "type": "tempo", "x": 40, "y": 40, "params": {"bpm": 136, "swing": 53, "tpb": 8, "volume": 1}, "hidden": true}, {"id": "out", "type": "out", "x": 240, "y": 40, "params": {"gain": 1}}, {"id": "bus", "type": "bus-in", "x": 40, "y": 140}], "connections": []}, "noteColumns": 0, "exposed": [{"node": "m", "param": "bpm", "label": "BPM", "bits": 16}, {"node": "m", "param": "swing", "label": "Swg"}, {"node": "m", "param": "tpb", "label": "TPB"}, {"node": "m", "param": "volume", "label": "Vol"}, {"node": "m", "param": "limit", "label": "Lim", "long": "Limiter", "bits": 4}, {"node": "m", "param": "ceiling", "label": "Ceil", "long": "Ceiling"}, {"node": "m", "param": "boost", "label": "Gain", "long": "Limiter gain"}, {"node": "m", "param": "release", "label": "Rel", "long": "Limiter release", "scale": "log"}, {"node": "m", "param": "carve", "label": "Crv", "long": "Carve", "bits": 4}, {"node": "m", "param": "cvamt", "label": "CAmt", "long": "Carve amount"}, {"node": "m", "param": "cvdepth", "label": "CDep", "long": "Carve depth"}, {"node": "m", "param": "cvfocus", "label": "CFoc", "long": "Carve focus"}], "commands": []}, "lone": {"graph": {"nodes": [{"id": "synth", "type": "genexpr", "x": 24, "y": 107, "params": {}, "data": {"code": "// Karplus-Strong: a burst of noise goes round a delay line one period long, and a lowpass in the loop takes a little of\n// the top off on every trip, so the sound dies away like a string. A note starts the burst (trig).\nParam decay(0.997, min=0.95, max=0.9999);  // the loop gain: nearer 1 rings longer\nParam bright(0.6, min=0.05, max=1);        // the lowpass in the loop\nDelay line(4096);                          // up to about 12 Hz at 48 kHz\nHistory lp(0);\nHistory count(0);\n\ncount = trig ? samplerate / freq : max(count - 1, 0);\nburst = count > 0 ? noise() : 0;\nperiod = clamp(samplerate / freq - 1, 2, 4000);\ny = line.read(period);\nlp = lp + (y - lp) * bright;\nline.write(burst + lp * (gate ? decay : decay * 0.9));   // a key let go damps it\nout1 = y * vel * 0.8;\nout2 = out1;\n"}}, {"id": "poly", "type": "voices", "x": 170, "y": 108}, {"id": "out", "type": "out", "params": {"gain": 0.5}, "x": 594, "y": 132}, {"id": "prismacanyon1", "type": "prismacanyon", "x": 380, "y": 130, "params": {"time": 588.1233933161953, "cutoff": 13660.942587832049, "dry": 0.4625535561268209, "reverb": 0.48449014567266496, "echo": 0.15912596401028278, "intensity": 0.916649528706084, "bass": -6.689974293059126, "treble": -7.611311053984576}}], "connections": [["synth.out1", "poly.in"], ["poly.out", "out.in"]], "voices": 6}, "noteColumns": 6, "exposed": [{"node": "synth", "param": "p1", "label": "Cut"}, {"node": "synth", "param": "p1", "label": "Res"}, {"node": "synth", "param": "p1", "label": "Pos"}, {"node": "synth", "param": "p1", "label": "Fld"}], "commands": [{"id": 1, "node": "synth", "param": "p1"}, {"id": 2, "node": "synth", "param": "p1"}, {"id": 3, "node": "synth", "param": "p1"}, {"id": 4, "node": "synth", "param": "p1"}, {"id": 5, "node": "synth", "param": "p1"}, {"id": 6, "node": "synth", "param": "p1"}, {"id": 7, "node": "synth", "param": "p1"}, {"id": 8, "node": "synth", "param": "p1"}, {"id": 9, "node": "synth", "param": "p1"}, {"id": 10, "node": "synth", "param": "p1"}]}}, "samples": {}, "lanes": [{"id": "master", "instrument": "master", "patterns": {}, "placements": []}, {"id": "lone", "instrument": "lone", "patterns": {"1794611646149-1": {"name": "pat00", "index": 0, "color": 0, "rows": ["D-4 .. C-5 .. G-4 .. ... .. ... .. ... .. .. .. .. .. ......", "... .. ... .. ... .. ... .. ... .. ... .. .. .. .. .. ......", "=== .. === .. === .. ... .. ... .. ... .. .. .. .. .. ......", "... .. ... .. ... .. ... .. ... .. ... .. .. .. .. .. ......", "... .. ... .. ... .. ... .. ... .. ... .. .. .. .. .. ......", "... .. ... .. 